# deploy/opal-bridge.env sur le VPS (chmod 600, jamais commité)
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OPAL_DEVICE_TOKEN=

# Voix locale gratuite (si pas de TTS OpenAI) : modèle Piper .onnx
# ex. fr_FR-siwis-medium.onnx  — sinon repli espeak-ng
# OPAL_PIPER_MODEL=/app/data/piper/fr_FR-siwis-medium.onnx
