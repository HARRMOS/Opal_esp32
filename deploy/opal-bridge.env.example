# deploy/opal-bridge.env sur le VPS (chmod 600, jamais commité)
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Même valeur que OPAL_DEVICE_TOKEN dans firmware/include/secrets.h
OPAL_DEVICE_TOKEN=

# Mot de passe du direct vidéo https://iris.inoma.pro/opal/cam (n'importe quel identifiant)
OPAL_VIEWER_PASSWORD=

# Abonnement Claude pour décrire les photos (même valeur que dans le .env d'Opal)
CLAUDE_CODE_OAUTH_TOKEN=

# Optionnel
# OPAL_GREET=1
# OPAL_GREET_COOLDOWN_S=3600
# OPAL_CAM_MIRROR=0
# OPAL_STT_MODEL=small
# OPAL_TTS_VOICE=fr-FR-RemyMultilingualNeural
# OPAL_TTS_RATE=-10%
