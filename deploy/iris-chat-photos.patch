+// Photos de la caméra d'Opal Box (servies par le pont, même domaine) : affichées dans
+// le message plutôt qu'en simple lien. La ponctuation qui suit l'URL reste du texte.
+const OPAL_PHOTO = /^\/opal\/cam\/photos\/[\w-]+\.jpg$/;
+
+function link(match) {
+  const [, url, tail] = match.match(/^(.*?)([.,;:!?]*)$/);
+  let photo = false;
+  try {
+    const u = new URL(url.replace(/&amp;/g, "&"));
+    photo = u.origin === location.origin && OPAL_PHOTO.test(u.pathname);
+  } catch {}
+  if (photo) {
+    return `<a class="opal-photo" href="${url}" target="_blank" rel="noopener"><img src="${url}" alt="Photo prise par Opal Box" loading="lazy"></a>${tail}`;
+  }
+  return `<a href="${url}" target="_blank" rel="noopener">${url}</a>${tail}`;
+}
+
 function inline(text) {
   return esc(text)
     .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
     .replace(/`([^`]+)`/g, "<code>$1</code>")
-    .replace(/(https?:\/\/[^\s<)]+)/g, '<a href="$1" target="_blank" rel="noopener">$1</a>');
+    .replace(/https?:\/\/[^\s<)]+/g, link);
 }
 
